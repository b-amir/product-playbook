{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b-amir/product-playbook/schemas/plan.schema.json",
  "title": "Product Playbook render plan",
  "type": "object",
  "required": ["chapters"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "actors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "setup": {
      "type": "array",
      "items": { "type": "string" }
    },
    "interfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "automated_tests": {
      "type": "object",
      "description": "Opt-in from Intake/Plan. When enabled, Write also generates runnable tests.",
      "properties": {
        "enabled": { "type": "boolean" },
        "framework": { "type": "string" },
        "tests_dir": { "type": "string" },
        "acceptance_file": { "type": "string" }
      }
    },
    "smoke_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenarios"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "intro": { "type": "string" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "steps", "expected"],
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]{1,5}-\\d{2,3}$"
                },
                "title": { "type": "string" },
                "goal": { "type": "string" },
                "who": { "type": "string" },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "expected": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "setup": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "environment": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "What the environment must offer (real storage, a queue, a paid model). Rendered as an Environment section."
                },
                "cleanup": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "notes": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "automation": {
                  "type": "object",
                  "properties": {
                    "tags": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "enum": ["smoke", "safe", "destructive"] }
                    },
                    "requires": {
                      "type": "array",
                      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "description": "Environment capabilities the automated test needs (s3, sqs, llm-real)."
                    },
                    "manual_only": { "type": "boolean" },
                    "reason": { "type": "string" },
                    "acceptance": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                },
                "viewport_sensitive": { "type": "boolean" },
                "across_viewports": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
