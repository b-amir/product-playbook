{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b-amir/product-playbook/schemas/plan.schema.json",
  "title": "Product Playbook render plan",
  "type": "object",
  "required": ["chapters"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "actors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "setup": {
      "type": "array",
      "items": { "type": "string" }
    },
    "interfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "smoke_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenarios"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "intro": { "type": "string" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "steps", "expected"],
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]{1,5}-\\d{2,3}$"
                },
                "title": { "type": "string" },
                "goal": { "type": "string" },
                "who": { "type": "string" },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "expected": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "setup": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "cleanup": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "notes": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
