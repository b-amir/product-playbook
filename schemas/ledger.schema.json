{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b-amir/product-playbook/schemas/ledger.schema.json",
  "title": "Product Playbook evidence ledger",
  "type": "object",
  "required": ["scenarios"],
  "additionalProperties": true,
  "properties": {
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sources"],
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["SOURCED", "VERIFIED", "UNRESOLVED"]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "path"],
              "additionalProperties": true,
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
